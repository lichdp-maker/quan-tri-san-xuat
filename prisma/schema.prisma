// Hệ thống theo dõi sản xuất — schema v2
// Cập nhật theo định mức thực tế G6 và GS06 V2, mốc giờ 9h30/11h40/14h30/16h20/19h40
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")       // Neon, chuỗi có -pooler
  directUrl = env("DIRECT_URL")         // Neon, chuỗi trực tiếp — dùng cho migrate
}

// ============================================================
// NGƯỜI DÙNG & TỔ CHỨC
// ============================================================
enum Role {
  WORKER
  TEAM_LEADER
  ENGINEER
  WAREHOUSE
  PLANNER
  SHOP_MANAGER
  DEPUTY_DIRECTOR
  DIRECTOR
}

model User {
  id           String   @id @default(cuid())
  employeeCode String   @unique
  fullName     String
  role         Role
  passwordHash String
  teamId       String?
  team         Team?    @relation("TeamMembers", fields: [teamId], references: [id])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Tình trạng nhân sự — tách khỏi isActive: nghỉ phép dài hạn vẫn giữ tài khoản
  tinhTrang TinhTrangNhanSu @default(DANG_LAM)
  ghiChu    String?

  // Phân quyền chi tiết: chênh lệch so với bộ mặc định của vai trò
  quyenThem String[] @default([])
  quyenBot  String[] @default([])

  // Bảo mật đăng nhập
  mustChangePassword Boolean   @default(false) // true = bắt đổi mật khẩu trước khi làm gì khác
  passwordChangedAt  DateTime? // phiên cấp trước mốc này bị vô hiệu
  failedLogins       Int       @default(0)
  lockedUntil        DateTime? // khoá tạm sau nhiều lần sai mật khẩu

  ledTeams        Team[]            @relation("TeamLeader")
  assignments     Assignment[]
  entriesCreated  ProductionEntry[] @relation("EntryCreatedBy")
  entriesApproved ProductionEntry[] @relation("EntryApprovedBy")
  auditLogs       AuditLog[]

  @@index([teamId, isActive])
  @@index([role])
  @@index([tinhTrang])
}

enum TinhTrangNhanSu {
  DANG_LAM     // đang làm việc bình thường
  TANG_CUONG   // tăng cường từ bộ phận / nhà máy khác
  MUA_VU       // lao động mùa vụ
  NGHI_DAI_HAN // nghỉ phép dài hạn, vẫn giữ tài khoản
  NGHI_VIEC    // đã nghỉ việc, không đăng nhập được nữa
}

model Team {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String
  leaderId String?
  leader   User?   @relation("TeamLeader", fields: [leaderId], references: [id])
  isActive Boolean @default(true)

  members     User[]       @relation("TeamMembers")
  assignments Assignment[]
  lines       Line[]
}

// ============================================================
// SẢN PHẨM — BỘ PHẬN — NGUYÊN CÔNG
// GS06 V2 là "bộ": 3 bộ phận chạy song song + bao gói chốt cuối.
// G6 là sản phẩm đơn: 1 bộ phận duy nhất.
// ============================================================
model Product {
  id       String  @id @default(cuid())
  code     String  @unique              // G6, GS06V2
  name     String
  unit     String  @default("sp")       // sp | bộ
  isKit    Boolean @default(false)      // true = bộ gồm nhiều bộ phận
  isActive Boolean @default(true)

  sections ProductSection[]
  orders   ProductionOrder[]
}

model ProductSection {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  code      String                       // HD, HT, CD, BG, G6
  name      String                       // Đầu báo khói, Đầu báo nhiệt, Chuông đèn, Bao gói
  seq       Int                          // thứ tự hiển thị
  // true = chỉ bắt đầu được khi mọi bộ phận khác đã có sản lượng (bao gói)
  dependsOnAllSections Boolean @default(false)
  isActive  Boolean @default(true)

  operations Operation[]

  @@unique([productId, code])
}

model Operation {
  id              String         @id @default(cuid())
  sectionId       String
  section         ProductSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  seq             Int                       // thứ tự trong bộ phận
  code            String                    // G6-01, HD-05...
  name            String
  detail          String?
  standardSeconds Int                       // ĐỊNH MỨC: giây/đơn vị (nguồn: file định mức công nghệ)
  targetPercent   Int      @default(100)    // ngưỡng đạt năng suất của nguyên công này (%)
  isQC            Boolean  @default(false)
  isActive        Boolean  @default(true)   // false = nguyên công đã bỏ
  note            String?
  unitPrice       Decimal? @db.Decimal(12, 2) // giai đoạn 2: lương sản phẩm

  orderOperations OrderOperation[]
  seats           Seat[]
  lines           LineOperation[]

  @@unique([sectionId, seq])
  @@index([sectionId, isActive])
}

// ============================================================
// CA & MỐC GIỜ (cấu hình được)
// ============================================================
model Shift {
  id        String  @id @default(cuid())
  code      String  @unique              // CA1
  name      String
  startTime String                        // "08:00"
  endTime   String                        // "21:00"
  isActive  Boolean @default(true)

  timeSlots   TimeSlot[]
  assignments Assignment[]
  lines       Line[]
}

model TimeSlot {
  id           String  @id @default(cuid())
  shiftId      String
  shift        Shift   @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  seq          Int
  label        String                     // "9h30", "11h40", "14h30", "16h20", "19h40"
  startTime    String                     // mốc trước
  endTime      String                     // mốc này
  breakMinutes Int     @default(0)         // nghỉ giữa khoảng (nghỉ trưa...)
  graceMinutes Int     @default(30)        // quá hạn này chưa nhập -> cảnh báo
  isActive     Boolean @default(true)

  entries ProductionEntry[]

  @@unique([shiftId, seq])
}

// ============================================================
// LỆNH SẢN XUẤT
// ============================================================
enum OrderStatus {
  DRAFT
  RELEASED
  IN_PROGRESS
  COMPLETED
  CLOSED
  CANCELLED
}

model ProductionOrder {
  id          String      @id @default(cuid())
  code        String      @unique
  productId   String
  product     Product     @relation(fields: [productId], references: [id])
  quantity    Int
  priority    Int         @default(0)
  dueDate     DateTime?
  status      OrderStatus @default(DRAFT)
  note        String?
  createdById String
  createdAt   DateTime    @default(now())
  releasedAt  DateTime?
  closedAt    DateTime?

  operations OrderOperation[]
  lines      Line[]

  @@index([status, dueDate])
}

model OrderOperation {
  id              String          @id @default(cuid())
  orderId         String
  order           ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  operationId     String
  operation       Operation       @relation(fields: [operationId], references: [id])
  sectionCode     String                    // snapshot để truy vấn nhanh
  seq             Int
  targetQty       Int
  standardSeconds Int                       // SNAPSHOT định mức lúc phát lệnh
  doneQtyOk       Int             @default(0)
  doneQtyDefect   Int             @default(0)

  assignments Assignment[]

  @@unique([orderId, operationId])
  @@index([orderId, sectionCode, seq])
}

// ============================================================
// DÂY CHUYỀN & VỊ TRÍ NGỒI
// Sơ đồ dây chuyền ngồi hai mặt. Mỗi vị trí gắn sẵn một nguyên công;
// kéo công nhân vào vị trí là người đó nhận nguyên công của vị trí đó.
// ============================================================
/** Kiểu vị trí sản xuất — quyết định cách vẽ trên sơ đồ và cách xếp chỗ. */
enum LoaiViTri {
  CHUYEN // băng chuyền ngồi hai mặt
  BAN    // dãy bàn một hàng, ví dụ bàn đầu kiểm 1-8
  MAY    // máy đứng lẻ, không có chỗ ngồi cố định
}

model Line {
  id       String    @id @default(cuid())
  code     String    @unique // DC1, DC2
  name     String
  soGhe    Int       @default(20)
  loai     LoaiViTri @default(CHUYEN)
  teamId   String?
  team     Team?     @relation(fields: [teamId], references: [id])
  isActive Boolean   @default(true)

  // Vị trí trên sơ đồ mặt bằng xưởng. Toạ độ tính theo phần trăm khung của tầng,
  // nên sơ đồ co giãn đúng trên cả điện thoại lẫn máy tính.
  tang   Int @default(2)
  viTriX Int @default(5) // % tính từ mép trái
  viTriY Int @default(5) // % tính từ mép trên
  rong   Int @default(60) // % chiều rộng khung
  cao    Int @default(10) // % chiều cao khung

  // Lệnh đang chạy trên dây chuyền này — quyết định nguyên công nào gán được cho ghế
  currentOrderId String?
  currentOrder   ProductionOrder? @relation(fields: [currentOrderId], references: [id])
  shiftId        String?
  shift          Shift?           @relation(fields: [shiftId], references: [id])

  seats      Seat[]
  operations LineOperation[]

  @@index([tang, isActive])
}

/**
 * Nguyên công mà một chuyền được phép làm.
 *
 * Mỗi chuyền chỉ đảm nhận một phần công đoạn của sản phẩm, không phải toàn bộ:
 * chuyền lắp ráp làm phần lắp, bàn đầu kiểm làm phần kiểm, chuyền bao gói làm
 * phần bao gói. Danh sách này lọc lại ô chọn nguyên công của từng ghế.
 *
 * Chuyền chưa cấu hình gì thì được coi là làm mọi nguyên công của lệnh đang chạy.
 */
model LineOperation {
  id          String    @id @default(cuid())
  lineId      String
  line        Line      @relation(fields: [lineId], references: [id], onDelete: Cascade)
  operationId String
  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  seq         Int       @default(0)

  @@unique([lineId, operationId])
  @@index([lineId])
}

enum SeatSide {
  A // mặt trên của dây chuyền
  B // mặt dưới
}

model Seat {
  id     String   @id @default(cuid())
  lineId String
  line   Line     @relation(fields: [lineId], references: [id], onDelete: Cascade)
  seq    Int // số thứ tự vị trí trong mặt đó: 1..10
  side   SeatSide
  label  String? // tên gọi riêng nếu có

  operationId String?
  operation   Operation? @relation(fields: [operationId], references: [id])

  assignments Assignment[]

  @@unique([lineId, side, seq])
  @@index([lineId])
}

// ============================================================
// PHÂN CÔNG & NHẬP LIỆU
// Một công nhân có thể được gán NHIỀU nguyên công, NHIỀU lệnh trong cùng một ngày.
// ============================================================
model Assignment {
  id               String         @id @default(cuid())
  orderOperationId String
  orderOperation   OrderOperation @relation(fields: [orderOperationId], references: [id], onDelete: Cascade)
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  teamId           String
  team             Team           @relation(fields: [teamId], references: [id])
  shiftId          String
  shift            Shift          @relation(fields: [shiftId], references: [id])
  workDate         DateTime       @db.Date
  targetQty        Int?                      // chỉ tiêu ca (phụ)
  seatId           String?                   // vị trí ngồi trên dây chuyền, nếu gán bằng sơ đồ
  seat             Seat?          @relation(fields: [seatId], references: [id])
  assignedById     String
  createdAt        DateTime       @default(now())

  entries ProductionEntry[]

  @@unique([orderOperationId, userId, workDate, shiftId])
  @@index([userId, workDate])
  @@index([teamId, workDate])
}

enum EntryStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProductionEntry {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  timeSlotId   String
  timeSlot     TimeSlot   @relation(fields: [timeSlotId], references: [id])
  workDate     DateTime   @db.Date
  slotStartAt  DateTime                       // snapshot mốc giờ thật lúc nhập
  slotEndAt    DateTime

  qtyOk     Int                                // sản lượng ĐẠT trong khoảng (không lũy kế)
  qtyDefect Int @default(0)

  // Thời gian dành cho nguyên công NÀY trong mốc — cần vì 1 người làm nhiều nguyên công/mốc
  workedMinutes   Int
  downtimeMinutes Int     @default(0)
  downtimeReasonId String?
  downtimeReason   DowntimeReason? @relation(fields: [downtimeReasonId], references: [id])

  // Cache kết quả năng suất, tính lúc duyệt (tránh tính lại khi báo cáo)
  earnedSeconds Int?                            // qtyOk * standardSeconds
  netMinutes    Int?                            // workedMinutes - downtimeMinutes
  performance   Decimal? @db.Decimal(6, 2)      // % = earnedSeconds/60 / netMinutes * 100
  isAchieved    Boolean?                        // performance > targetPercent của nguyên công

  note         String?
  status       EntryStatus @default(PENDING)
  createdById  String
  createdBy    User        @relation("EntryCreatedBy", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?       @relation("EntryApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  defects DefectRecord[]

  @@unique([assignmentId, timeSlotId, workDate])
  @@index([workDate, status])
  @@index([createdById, workDate])
}

model DowntimeReason {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String                           // chờ vật tư, hỏng máy, mất điện, chờ kiểm tra...
  isActive Boolean @default(true)

  entries ProductionEntry[]
}

// ============================================================
// SAI HỎNG
// ============================================================
enum DefectDisposition {
  PENDING
  REWORK
  SCRAP
  USE_AS_IS
  RETURN_SUPPLIER
}

model DefectType {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String
  group    String
  isActive Boolean @default(true)

  records DefectRecord[]
}

model DefectCause {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String
  category String                           // CON NGƯỜI / MÁY / VẬT TƯ / PHƯƠNG PHÁP / ĐO LƯỜNG / MÔI TRƯỜNG
  isActive Boolean @default(true)

  records DefectRecord[]
}

model DefectRecord {
  id           String            @id @default(cuid())
  entryId      String
  entry        ProductionEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  defectTypeId String
  defectType   DefectType        @relation(fields: [defectTypeId], references: [id])
  qty          Int
  causeId      String?
  cause        DefectCause?      @relation(fields: [causeId], references: [id])
  disposition  DefectDisposition @default(PENDING)
  photoUrl     String?
  engineerNote String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime          @default(now())

  @@index([defectTypeId])
  @@index([causeId])
  @@index([disposition])
}

// ============================================================
// NHẬT KÝ
// ============================================================
model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId, createdAt])
}
