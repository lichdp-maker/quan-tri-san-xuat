# Neon Postgres — lấy từ bảng điều khiển Neon
# DATABASE_URL: chuỗi có "-pooler" (dùng cho ứng dụng chạy trên Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: chuỗi KHÔNG có "-pooler" (dùng cho prisma migrate)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Auth.js — tạo chuỗi ngẫu nhiên: npx auth secret
AUTH_SECRET="thay-bang-chuoi-ngau-nhien"
AUTH_TRUST_HOST=true

# Múi giờ hiển thị
TZ="Asia/Ho_Chi_Minh"
