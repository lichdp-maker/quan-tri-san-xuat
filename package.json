{
  "name": "theo-doi-san-xuat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && next build",
    "db:batdoimk": "tsx prisma/bat-doi-mat-khau.ts",
    "db:demo": "tsx prisma/seed-demo.ts",
    "db:migrate": "prisma migrate dev",
    "db:nhansu": "tsx prisma/seed-nhan-su.ts",
