    "@vitest/coverage-v8": "^3.0.5",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.2.0",
    "postcss": "^8.5.1",
    "prisma": "^6.5.0",
