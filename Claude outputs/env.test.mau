# Mẫu cấu hình cho test tích hợp — chép thành .env.test rồi điền.
#
# PHẢI là một CSDL RIÊNG. Bộ test xoá sạch mọi bảng trước mỗi lần chạy,
# trỏ nhầm vào CSDL đang dùng thật là mất toàn bộ số liệu sản xuất.
#
# Cách lấy nhanh trên Neon:
#   Neon Console > dự án > Branches > New branch > đặt tên "test"
#   rồi copy chuỗi kết nối của nhánh đó vào đây.
#
# Tên nhánh hoặc tên CSDL bắt buộc phải chứa "test" (hoặc dev/local/branch),
# nếu không tests/moi-truong.ts sẽ từ chối chạy — đó là hàng rào chống trỏ nhầm.

DATABASE_URL_TEST="postgresql://user:pass@ep-xxx-test.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Tài khoản thật dùng cho Playwright E2E (không bắt buộc, thiếu thì test tự bỏ qua)
# E2E_MA=
# E2E_MK=
# E2E_CN_MA=
# E2E_CN_MK=
# E2E_TT_MA=
# E2E_TT_MK=
